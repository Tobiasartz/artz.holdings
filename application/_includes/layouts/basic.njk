---
layout: layouts/base.njk
---
<section class="border-b border-ink-900/5 bg-sand-100">
	<div class="wrap py-12 md:py-16">
		{%- if eyebrow %}<p class="eyebrow">{{ eyebrow }}</p>{% endif %}
		<h1 class="mt-2 text-4xl font-semibold text-ink-900 md:text-5xl">{{ title }}</h1>
		{%- if description %}<p class="mt-4 max-w-2xl text-lg text-ink-500">{{ description }}</p>{% endif %}
	</div>
</section>
<section class="wrap py-12 md:py-16">
	<div class="{{ contentClass or 'legal max-w-3xl' }}">
		{{ content | safe }}
	</div>
</section>
