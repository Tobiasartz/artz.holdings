{%- from "components/icons.njk" import icon -%}
<section class="wrap py-20 md:py-24">
	<div class="relative overflow-hidden rounded-[2rem] bg-ink-900 px-6 py-14 text-center text-white shadow-soft md:px-12 md:py-20">
		<img src="/img/homes/old-town-poolside-retreat/patio-lounge.jpg" alt="" class="absolute inset-0 h-full w-full object-cover opacity-40" eleventy:widths="1280" sizes="100vw">
		<div class="absolute inset-0 bg-gradient-to-br from-ink-900/80 via-ink-900/60 to-clay-800/60"></div>
		<div class="relative mx-auto max-w-2xl">
			<p class="eyebrow !text-gold-400">Ready when you are</p>
			<h2 class="mt-3 text-3xl font-semibold md:text-5xl">Your next Scottsdale getaway starts with a quick message</h2>
			<p class="mt-4 text-lg text-white/80">Tell us your dates and who's coming. We'll confirm availability and send a direct quote, usually within a few hours.</p>
			<div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
				<a href="/book/" class="btn-primary">Request to book {{ icon("arrow", "h-4 w-4") }}</a>
				<a href="mailto:{{ metadata.booking.email }}" class="btn-ghost">{{ icon("mail", "h-4 w-4") }} {{ metadata.booking.email }}</a>
			</div>
		</div>
	</div>
</section>
