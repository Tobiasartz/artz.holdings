{#- Expects `p` (a property object). Optional `featured` boolean. -#}
{%- from "components/icons.njk" import icon -%}
<article class="card group flex flex-col overflow-hidden">
	<a href="/homes/{{ p.slug }}/" class="relative block aspect-[4/3] overflow-hidden bg-sand-200" aria-label="See {{ p.name }}">
		<img src="{{ p.cardImage.src }}" alt="{{ p.cardImage.alt }}" class="h-full w-full object-cover transition duration-700 group-hover:scale-105" eleventy:widths="640,1280" sizes="(min-width: 1024px) 400px, (min-width: 640px) 50vw, 100vw">
		<div class="absolute inset-x-0 bottom-0 h-24 bg-gradient-to-t from-ink-900/60 to-transparent"></div>
		{%- if p.badge %}<span class="absolute left-4 top-4 rounded-full bg-white/90 px-3 py-1 text-xs font-semibold text-ink-900 backdrop-blur">{{ p.badge }}</span>{% endif %}
		<span class="absolute bottom-4 left-4 inline-flex items-center gap-1 rounded-full bg-ink-900/70 px-3 py-1 text-xs font-semibold text-white backdrop-blur">
			{{ icon("star", "h-3.5 w-3.5 text-gold-400") }} {{ p.rating | rating }} <span class="font-normal text-white/80">({{ p.reviewCount }} reviews)</span>
		</span>
	</a>
	<div class="flex flex-1 flex-col p-6">
		<h3 class="text-2xl font-semibold text-ink-900"><a href="/homes/{{ p.slug }}/" class="hover:text-clay-700">{{ p.name }}</a></h3>
		<p class="mt-1 text-sm text-ink-500">{{ p.tagline }}</p>
		<ul class="mt-4 flex flex-wrap gap-x-4 gap-y-1 text-sm text-ink-700">
			<li class="inline-flex items-center gap-1.5">{{ icon("bed", "h-4 w-4 text-clay-600") }} {{ p.bedrooms }} bedrooms</li>
			<li class="inline-flex items-center gap-1.5">{{ icon("bath", "h-4 w-4 text-clay-600") }} {{ p.bathrooms }} baths</li>
			<li class="inline-flex items-center gap-1.5">{{ icon("users", "h-4 w-4 text-clay-600") }} Sleeps {{ p.guests }}</li>
		</ul>
		<ul class="mt-4 flex flex-wrap gap-2">
			{%- for h in p.highlights | head(3) %}
			<li class="chip">{{ icon(h.icon, "h-3.5 w-3.5 text-clay-600") }} {{ h.title }}</li>
			{%- endfor %}
		</ul>
		<div class="mt-6 flex flex-col gap-3 sm:flex-row">
			<a href="/homes/{{ p.slug }}/" class="btn-secondary flex-1">See the home</a>
			<a href="/book/?home={{ p.slug }}" class="btn-primary flex-1">Request to book</a>
		</div>
	</div>
</article>
