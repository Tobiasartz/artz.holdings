---
layout: layouts/basic.njk
title: Generate agreement link
eyebrow: Owner tools
description: Build a pre-filled rental agreement link for a direct booking.
contentClass: max-w-2xl
eleventyExcludeFromCollections: true
noindex: true
---
{%- from "components/icons.njk" import icon -%}
<p class="mb-6 text-ink-500">Fill in the booking and copy the link into the guest's confirmation email. The agreement can only be generated for homes owned by ArtzHoldings LLC.</p>

<form id="linkForm" class="card space-y-5 p-6 md:p-8">
	<div>
		<label class="mb-1 block text-sm font-medium text-ink-800" for="home">Home</label>
		<select id="home" name="home" required class="w-full rounded-xl border border-sand-300 bg-white px-3 py-2">
			{%- for p in properties %}{% if p.ownedByCompany %}
			<option value="{{ p.slug }}">{{ p.name }} · {{ p.address }} · STR {{ p.strLicense }}</option>
			{%- endif %}{% endfor %}
		</select>
	</div>

	<div>
		<label class="mb-1 block text-sm font-medium text-ink-800" for="guestName">Primary guest name</label>
		<input id="guestName" type="text" name="guestName" required class="w-full rounded-xl border border-sand-300 px-3 py-2">
	</div>

	<div class="grid gap-4 sm:grid-cols-2">
		<div>
			<label class="mb-1 block text-sm font-medium text-ink-800" for="arrivalDate">Arrival date</label>
			<input id="arrivalDate" type="date" name="arrivalDate" required class="w-full rounded-xl border border-sand-300 px-3 py-2">
		</div>
		<div>
			<label class="mb-1 block text-sm font-medium text-ink-800" for="numDays">Nights</label>
			<input id="numDays" type="number" name="numDays" min="1" value="2" required class="w-full rounded-xl border border-sand-300 px-3 py-2">
		</div>
		<div>
			<label class="mb-1 block text-sm font-medium text-ink-800" for="dailyRate">Nightly rate (USD)</label>
			<input id="dailyRate" type="number" name="dailyRate" min="0" step="0.01" value="375.00" required class="w-full rounded-xl border border-sand-300 px-3 py-2">
		</div>
		<div>
			<label class="mb-1 block text-sm font-medium text-ink-800" for="cleaningFee">Cleaning fee (USD)</label>
			<input id="cleaningFee" type="number" name="cleaningFee" min="0" step="0.01" value="150.00" required class="w-full rounded-xl border border-sand-300 px-3 py-2">
		</div>
	</div>

	<div>
		<p class="mb-2 block text-sm font-medium text-ink-800">Additional guests</p>
		<div id="additionalGuests" class="space-y-2"></div>
		<button type="button" id="addGuestBtn" class="btn-secondary mt-2 !px-4 !py-2 !text-xs">+ Add guest</button>
	</div>

	<button type="submit" class="btn-primary w-full">Generate link</button>
</form>

<div id="result" class="card mt-6 hidden p-6">
	<label class="mb-1 block text-sm font-medium text-ink-800" for="resultLink">Generated link</label>
	<div class="flex gap-2">
		<input type="text" id="resultLink" readonly class="flex-1 rounded-xl border border-sand-300 bg-sand-50 px-3 py-2 text-sm">
		<button type="button" id="copyBtn" class="btn-secondary !px-4 !py-2">Copy</button>
	</div>
	<a id="openLink" href="#" target="_blank" rel="noopener" class="mt-3 inline-flex items-center gap-1 text-sm font-medium text-clay-700 hover:underline">Open in new tab {{ icon("arrow", "h-3.5 w-3.5") }}</a>
</div>

<script>
	const relations = ['Spouse', 'Child', 'Family Member', 'Friend'];
	const additionalGuestsEl = document.getElementById('additionalGuests');

	function addGuestRow() {
		const row = document.createElement('div');
		row.className = 'flex gap-2 guest-row';
		row.innerHTML = `
			<input type="text" placeholder="Name" class="guest-name flex-1 rounded-xl border border-sand-300 px-3 py-2">
			<select class="guest-relation rounded-xl border border-sand-300 bg-white px-3 py-2">
				<option value="">Relation</option>
				${relations.map(r => `<option value="${r}">${r}</option>`).join('')}
			</select>
			<button type="button" class="remove-btn rounded-xl bg-clay-50 px-3 py-2 text-clay-700" aria-label="Remove guest">×</button>
		`;
		row.querySelector('.remove-btn').addEventListener('click', () => row.remove());
		additionalGuestsEl.appendChild(row);
	}

	document.getElementById('addGuestBtn').addEventListener('click', addGuestRow);

	document.getElementById('linkForm').addEventListener('submit', function (e) {
		e.preventDefault();
		const fd = new FormData(this);

		// YYYY-MM-DD -> MM/DD/YYYY, which the agreement expects
		const [y, m, d] = fd.get('arrivalDate').split('-');
		const arrivalDate = `${m}/${d}/${y}`;

		const additionalGuests = [];
		document.querySelectorAll('.guest-row').forEach(row => {
			const name = row.querySelector('.guest-name').value.trim();
			const relation = row.querySelector('.guest-relation').value;
			if (name) additionalGuests.push({ name, relation });
		});

		const params = new URLSearchParams({
			home: fd.get('home'),
			guestName: fd.get('guestName'),
			arrivalDate,
			numDays: fd.get('numDays'),
			dailyRate: fd.get('dailyRate'),
			cleaningFee: fd.get('cleaningFee'),
		});
		if (additionalGuests.length) params.set('additionalGuests', JSON.stringify(additionalGuests));

		const url = `${window.location.origin}/agreement/?${params.toString()}`;
		document.getElementById('resultLink').value = url;
		document.getElementById('openLink').href = url;
		document.getElementById('result').classList.remove('hidden');
	});

	document.getElementById('copyBtn').addEventListener('click', function () {
		const input = document.getElementById('resultLink');
		input.select();
		navigator.clipboard.writeText(input.value);
		this.textContent = 'Copied';
		setTimeout(() => (this.textContent = 'Copy'), 1500);
	});
</script>
