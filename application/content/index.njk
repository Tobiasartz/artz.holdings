---
layout: layouts/base.njk
title: Artz Holdings
eleventyNavigation:
  key: Home
  order: 1
---
{%- from "components/icons.njk" import icon -%}
{%- set hero = properties[0] -%}

{#- Hero -#}
<section class="relative isolate min-h-[min(92vh,56rem)] overflow-hidden bg-ink-900 text-white">
	<img src="{{ hero.heroImage.src }}" alt="{{ hero.heroImage.alt }}" class="absolute inset-0 -z-10 h-full w-full object-cover" eleventy:widths="960,1440" sizes="100vw" loading="eager" fetchpriority="high">
	<div class="absolute inset-0 -z-10 bg-gradient-to-t from-ink-900 via-ink-900/50 to-ink-900/20"></div>
	<div class="wrap flex min-h-[min(92vh,56rem)] flex-col justify-end pb-16 pt-32 md:pb-24">
		<p class="inline-flex w-fit max-w-full flex-wrap items-center gap-x-2 gap-y-1 rounded-full bg-white/15 px-4 py-1.5 text-sm backdrop-blur">
			{{ icon("star", "h-4 w-4 text-gold-400") }} <strong>{{ stats.averageRating }}</strong> across {{ stats.reviewCount }} reviews <span class="hidden sm:inline text-white/60">·</span> <span class="w-full sm:w-auto">Superhost since {{ 2026 - metadata.host.yearsHosting }}</span>
		</p>
		<h1 class="mt-6 max-w-4xl text-4xl font-semibold leading-[1.05] sm:text-5xl md:text-7xl">Two pool homes in Old Town Scottsdale. Booked direct with the family that owns them.</h1>
		<p class="mt-6 max-w-2xl text-lg text-white/85 md:text-xl">A heated, gated pool at one. A hot tub and four bedrooms at the other. Both sleep eight, both are stocked like a real home, and neither charges a platform fee when you book here.</p>
		<div class="mt-10 flex flex-col gap-3 sm:flex-row">
			<a href="#homes" class="btn-primary !px-8 !py-4 !text-base">See the homes {{ icon("arrow", "h-4 w-4") }}</a>
			<a href="/book/" class="btn-ghost !px-8 !py-4 !text-base">Request dates</a>
		</div>
		<ul class="mt-12 grid max-w-3xl grid-cols-2 gap-4 border-t border-white/15 pt-8 text-sm text-white/80 md:grid-cols-4">
			<li><span class="block font-display text-2xl font-semibold text-white">{{ stats.reviewCount }}+</span>guest reviews</li>
			<li><span class="block font-display text-2xl font-semibold text-white">{{ metadata.host.yearsHosting }} yrs</span>hosting in Scottsdale</li>
			<li><span class="block font-display text-2xl font-semibold text-white">Top 1%</span>of homes on Airbnb</li>
			<li><span class="block font-display text-2xl font-semibold text-white">$0</span>platform fees booking direct</li>
		</ul>
	</div>
</section>

{#- Homes: editorial feature panels -#}
<section id="homes" class="wrap scroll-mt-20 py-20 md:py-28">
	<div class="max-w-2xl">
		<p class="eyebrow">Our homes</p>
		<h2 class="mt-3 text-3xl font-semibold text-ink-900 md:text-5xl">Two homes, one standard</h2>
		<p class="mt-4 text-lg text-ink-500">Both are privately owned, professionally cleaned between every stay, and rated near-perfect by the guests who came before you. The only real question is which backyard fits your trip.</p>
	</div>

	<div class="mt-14 space-y-10 md:space-y-16">
		{%- for p in properties %}
		<article class="card group grid overflow-hidden lg:grid-cols-12 lg:items-stretch">
			<a href="/homes/{{ p.slug }}/" class="relative block aspect-[4/3] overflow-hidden bg-sand-200 lg:col-span-7 lg:aspect-auto lg:min-h-[30rem] {% if loop.index is even %}lg:order-2{% endif %}" aria-label="See {{ p.name }}">
				<img src="{{ p.heroImage.src }}" alt="{{ p.heroImage.alt }}" class="absolute inset-0 h-full w-full object-cover transition duration-700 group-hover:scale-[1.03]" eleventy:widths="800,1400" sizes="(min-width: 1024px) 58vw, 100vw" loading="lazy">
				<div class="absolute inset-x-0 bottom-0 h-28 bg-gradient-to-t from-ink-900/55 to-transparent"></div>
				{%- if p.badge %}<span class="absolute left-5 top-5 rounded-full bg-white/90 px-3 py-1 text-xs font-semibold text-ink-900 backdrop-blur">{{ p.badge }}</span>{% endif %}
				<span class="absolute bottom-5 left-5 inline-flex items-center gap-1.5 rounded-full bg-ink-900/70 px-3 py-1.5 text-sm font-semibold text-white backdrop-blur">
					{{ icon("star", "h-4 w-4 text-gold-400") }} {{ p.rating | rating }} <span class="font-normal text-white/80">· {{ p.reviewCount }} reviews</span>
				</span>
			</a>
			<div class="flex flex-col justify-center p-7 md:p-10 lg:col-span-5 lg:p-12">
				<p class="eyebrow">{{ p.airbnbRank }}</p>
				<h3 class="mt-3 text-3xl font-semibold text-ink-900 md:text-4xl"><a href="/homes/{{ p.slug }}/" class="hover:text-clay-700">{{ p.name }}</a></h3>
				<p class="mt-3 text-lg text-ink-500">{{ p.tagline }}</p>
				<p class="mt-4 leading-relaxed text-ink-700">{{ p.editorial }}</p>
				<ul class="mt-6 flex flex-wrap gap-x-5 gap-y-2 text-sm font-medium text-ink-800">
					<li class="inline-flex items-center gap-1.5">{{ icon("bed", "h-4 w-4 text-clay-600") }} {{ p.bedrooms }} bedrooms</li>
					<li class="inline-flex items-center gap-1.5">{{ icon("bath", "h-4 w-4 text-clay-600") }} {{ p.bathrooms }} baths</li>
					<li class="inline-flex items-center gap-1.5">{{ icon("users", "h-4 w-4 text-clay-600") }} Sleeps {{ p.guests }}</li>
				</ul>
				<ul class="mt-5 flex flex-wrap gap-2">
					{%- for h in p.highlights | head(4) %}
					<li class="chip">{{ icon(h.icon, "h-3.5 w-3.5 text-clay-600") }} {{ h.title }}</li>
					{%- endfor %}
				</ul>
				<div class="mt-8 flex flex-col gap-3 sm:flex-row">
					<a href="/book/?home={{ p.slug }}" class="btn-primary flex-1">Request to book</a>
					<a href="/homes/{{ p.slug }}/" class="btn-secondary flex-1">Photos and details</a>
				</div>
			</div>
		</article>
		{%- endfor %}
	</div>

	{#- Side by side -#}
	<div class="mt-16 overflow-hidden rounded-3xl bg-white ring-1 ring-ink-900/5">
		<div class="grid gap-0 md:grid-cols-[minmax(10rem,1fr)_2fr_2fr]">
			<div class="hidden bg-sand-100 px-6 py-4 text-xs font-semibold uppercase tracking-wider text-ink-500 md:block">Side by side</div>
			{%- for p in properties %}
			<div class="bg-sand-100 px-6 py-4 text-sm font-semibold text-ink-900 md:text-base">{{ p.name }}</div>
			{%- endfor %}
		</div>
		{%- set rows = [
			{ label: "Bedrooms and baths", key: "bb" },
			{ label: "Sleeps", key: "sleeps" },
			{ label: "Water", key: "pool" },
			{ label: "Best for", key: "bestFor" },
			{ label: "Outdoors", key: "outdoor" },
			{ label: "Rating", key: "rating" }
		] -%}
		<dl class="divide-y divide-ink-900/5 text-sm text-ink-700">
			{%- for r in rows %}
			<div class="grid gap-x-6 gap-y-1 px-6 py-4 md:grid-cols-[minmax(10rem,1fr)_2fr_2fr] md:items-baseline">
				<dt class="font-medium text-ink-900">{{ r.label }}</dt>
				{%- for p in properties %}
				<dd class="md:contents">
					<span class="block md:col-auto"><span class="mr-2 font-semibold text-ink-900 md:hidden">{{ p.shortName }}:</span>
						{%- if r.key == "bb" %}{{ p.bedrooms }} bedrooms, {{ p.bathrooms }} baths
						{%- elif r.key == "sleeps" %}{{ p.guests }} guests, {{ p.beds }} beds
						{%- elif r.key == "pool" %}{{ p.compare.pool }}
						{%- elif r.key == "bestFor" %}{{ p.compare.bestFor }}
						{%- elif r.key == "outdoor" %}{{ p.compare.outdoor }}
						{%- elif r.key == "rating" %}<span class="inline-flex items-center gap-1">{{ icon("star", "h-3.5 w-3.5 text-gold-500") }} {{ p.rating | rating }} from {{ p.reviewCount }} reviews</span>
						{%- endif %}
					</span>
				</dd>
				{%- endfor %}
			</div>
			{%- endfor %}
		</dl>
	</div>
</section>

{% include "components/why-direct.njk" %}

{#- How it works -#}
<section class="wrap py-20 md:py-28">
	<div class="grid gap-12 lg:grid-cols-5 lg:items-start">
		<div class="lg:col-span-2">
			<p class="eyebrow">Booking direct</p>
			<h2 class="mt-3 text-3xl font-semibold text-ink-900 md:text-4xl">Three steps, no middleman</h2>
			<p class="mt-4 text-lg text-ink-500">You deal with the owners from the first message to checkout. No call center and no service fee added at the end.</p>
			<a href="/book/" class="btn-primary mt-8">Start a request {{ icon("arrow", "h-4 w-4") }}</a>
		</div>
		<ol class="grid gap-4 lg:col-span-3">
			{%- set steps = [
				{ n: "01", title: "Tell us your dates and group", text: "Pick a home, send your dates and who is coming. We check availability and reply, usually within the hour." },
				{ n: "02", title: "Approve a direct quote", text: "One clear number: nightly rate, cleaning and Arizona lodging tax. Nothing added at checkout." },
				{ n: "03", title: "Sign, pay, and get your code", text: "A short rental agreement, a secure payment link, then your keypad code and check-in guide land in your inbox before arrival." }
			] -%}
			{%- for s in steps %}
			<li class="flex gap-6 rounded-3xl bg-white p-6 ring-1 ring-ink-900/5 md:p-8">
				<span class="font-display text-3xl font-semibold text-clay-600">{{ s.n }}</span>
				<div>
					<h3 class="text-lg font-semibold text-ink-900">{{ s.title }}</h3>
					<p class="mt-2 leading-relaxed text-ink-500">{{ s.text }}</p>
				</div>
			</li>
			{%- endfor %}
		</ol>
	</div>
</section>

{#- Social proof -#}
<section class="bg-ink-900 py-20 text-white md:py-28">
	<div class="wrap grid items-center gap-12 lg:grid-cols-2">
		<div>
			<p class="eyebrow !text-gold-400">What guests say</p>
			<h2 class="mt-3 text-3xl font-semibold md:text-5xl">Rated {{ stats.averageRating }} by {{ stats.reviewCount }} guests</h2>
			<p class="mt-4 text-lg text-white/75">Both homes carry Airbnb's Guest Favorite badge and rank in the top 1% of homes on the platform. Cleanliness, accuracy, check-in, communication and location all score a perfect 5.0.</p>
			<div class="mt-8 flex flex-col gap-3 sm:flex-row">
				<a href="/book/" class="btn-primary">Request to book</a>
				<a href="#homes" class="btn-ghost">Compare the homes</a>
			</div>
		</div>
		<ul class="grid gap-4 sm:grid-cols-2">
			{%- for p in properties %}
			<li class="flex flex-col rounded-3xl bg-white/5 p-6 ring-1 ring-white/10">
				<p class="inline-flex items-center gap-1 font-display text-4xl font-semibold">{{ icon("star", "h-6 w-6 text-gold-400") }} {{ p.rating | rating }}</p>
				<p class="mt-1 text-sm text-white/70">{{ p.reviewCount }} reviews · {{ p.fiveStarShare }}% five stars</p>
				<p class="mt-4 text-base font-medium text-white">{{ p.name }}</p>
				<p class="mt-1 text-xs text-white/60">{{ p.airbnbRank }}</p>
				<blockquote class="mt-5 border-l-2 border-gold-400/60 pl-4 text-sm leading-relaxed text-white/80">{{ p.guestsSay[0] }}</blockquote>
			</li>
			{%- endfor %}
		</ul>
	</div>
</section>

{#- Explore Scottsdale -#}
<section class="wrap py-20 md:py-28">
	<div class="grid gap-12 lg:grid-cols-5">
		<div class="lg:col-span-2">
			<p class="eyebrow">The neighborhood</p>
			<h2 class="mt-3 text-3xl font-semibold text-ink-900 md:text-4xl">Minutes from Old Town, far from the crowds</h2>
			<p class="mt-4 text-lg text-ink-500">Both homes sit on quiet residential streets a short drive from Old Town Scottsdale, so you get the restaurants, nightlife and ballparks without sleeping next to them.</p>
			<div class="mt-8 overflow-hidden rounded-3xl">
				<img src="/img/homes/old-town-poolside-retreat/backyard-pergola.jpg" alt="Shaded patio with bougainvillea and a view of the pool" class="aspect-[4/3] w-full object-cover" eleventy:widths="640,1280" sizes="(min-width: 1024px) 40vw, 100vw" loading="lazy">
			</div>
		</div>
		<ul class="grid gap-4 sm:grid-cols-2 lg:col-span-3">
			{%- set spots = [
				{ icon: "utensils", title: "Old Town dining and nightlife", text: "Hundreds of restaurants, rooftop bars and galleries in the Entertainment District, minutes from your door." },
				{ icon: "trophy", title: "Spring Training", text: "Salt River Fields (Diamondbacks and Rockies) and Scottsdale Stadium (Giants) are both a short drive." },
				{ icon: "flag", title: "World-class golf", text: "TPC Scottsdale, home of the WM Phoenix Open, plus Silverado, Talking Stick and dozens of courses within 20 minutes." },
				{ icon: "mountain", title: "Desert hiking", text: "Camelback Mountain, Pinnacle Peak and the McDowell Sonoran Preserve trails for sunrise hikes." },
				{ icon: "bag", title: "Shopping", text: "Scottsdale Fashion Square and the Old Town boutiques, plus groceries close to both homes." },
				{ icon: "plane", title: "Easy airport run", text: "Phoenix Sky Harbor is about 20 minutes away. Free parking at both homes." }
			] -%}
			{%- for s in spots %}
			<li class="flex gap-4 rounded-2xl bg-white p-5 ring-1 ring-ink-900/5">
				<span class="grid h-10 w-10 shrink-0 place-items-center rounded-xl bg-pool-50 text-pool-600">{{ icon(s.icon, "h-5 w-5") }}</span>
				<div>
					<h3 class="font-semibold text-ink-900">{{ s.title }}</h3>
					<p class="mt-1 text-sm leading-relaxed text-ink-500">{{ s.text }}</p>
				</div>
			</li>
			{%- endfor %}
		</ul>
	</div>
</section>

{#- Host -#}
<section class="bg-sand-100 py-20">
	<div class="wrap grid items-center gap-10 lg:grid-cols-3">
		<div class="lg:col-span-2">
			<p class="eyebrow">Your hosts</p>
			<h2 class="mt-3 text-3xl font-semibold text-ink-900 md:text-4xl">A Scottsdale family that has hosted guests for {{ metadata.host.yearsHosting }} years</h2>
			<p class="mt-4 text-lg text-ink-500">We live in the Valley, we look after both homes ourselves, and we answer messages {{ metadata.host.responseTime }}. These are the homes we would want to stay in: stocked kitchens, fast WiFi, real beds in every room and a backyard worth the flight.</p>
		</div>
		<ul class="grid grid-cols-2 gap-4 text-center">
			<li class="card p-5"><span class="block font-display text-3xl font-semibold text-ink-900">{{ metadata.host.responseRate }}</span><span class="text-xs text-ink-500">response rate</span></li>
			<li class="card p-5"><span class="block font-display text-3xl font-semibold text-ink-900">&lt;1 hr</span><span class="text-xs text-ink-500">typical reply</span></li>
			<li class="card p-5"><span class="block font-display text-3xl font-semibold text-ink-900">{{ metadata.host.yearsHosting }}</span><span class="text-xs text-ink-500">years hosting</span></li>
			<li class="card p-5"><span class="block font-display text-3xl font-semibold text-ink-900">{{ stats.homes }}</span><span class="text-xs text-ink-500">homes, both Guest Favorites</span></li>
		</ul>
	</div>
</section>

{% include "components/faq.njk" %}
{% include "components/cta.njk" %}

<script type="application/ld+json">
{
	"@context": "https://schema.org",
	"@type": "LodgingBusiness",
	"name": "{{ metadata.brand }}",
	"legalName": "ArtzHoldings LLC",
	"url": "{{ metadata.root }}/",
	"image": "{{ metadata.root }}{{ metadata.ogImage }}",
	"email": "{{ metadata.booking.email }}",
	"address": { "@type": "PostalAddress", "addressLocality": "Scottsdale", "addressRegion": "AZ", "addressCountry": "US" },
	"aggregateRating": { "@type": "AggregateRating", "ratingValue": {{ stats.averageRating }}, "reviewCount": {{ stats.reviewCount }}, "bestRating": 5 }
}
</script>
