---
layout: layouts/base.njk
title: Request to book
description: Send your dates and group size for either of our two Scottsdale homes. We confirm availability and reply with a direct quote, usually within a few hours.
---
{%- from "components/icons.njk" import icon -%}

<section class="border-b border-ink-900/5 bg-sand-100">
	<div class="wrap grid gap-10 py-14 lg:grid-cols-3 lg:py-20">
		<div class="lg:col-span-2">
			<p class="eyebrow">Book direct</p>
			<h1 class="mt-3 text-4xl font-semibold text-ink-900 md:text-5xl">Request your dates</h1>
			<p class="mt-4 max-w-2xl text-lg text-ink-500">Tell us which home, when, and who's coming. We check the calendar and send you a direct quote with the nightly rate, cleaning fee and taxes spelled out. No platform service fee, ever.</p>
			<div id="selected-home" class="mt-6 hidden items-center gap-3 rounded-2xl bg-white px-4 py-3 text-sm ring-1 ring-ink-900/5">
				{{ icon("home", "h-4 w-4 text-clay-600") }} <span>You're requesting <strong data-selected-name></strong>. Please mention it in the form below.</span>
			</div>
		</div>
		<ol class="space-y-4 text-sm">
			{%- set steps = [
				["Send your request", "Home, dates, guests and any questions. Two minutes."],
				["Get a direct quote", "We confirm availability and reply " + metadata.host.responseTime + " with a clear total."],
				["Sign and pay securely", "A short rental agreement and a secure payment link. Done."],
				["Receive your keypad code", "Check-in guide and door code arrive before your trip."]
			] -%}
			{%- for s in steps %}
			<li class="flex gap-4">
				<span class="grid h-8 w-8 shrink-0 place-items-center rounded-full bg-clay-600 font-semibold text-white">{{ loop.index }}</span>
				<div><p class="font-semibold text-ink-900">{{ s[0] }}</p><p class="text-ink-500">{{ s[1] }}</p></div>
			</li>
			{%- endfor %}
		</ol>
	</div>
</section>

<section class="wrap py-12">
	<p class="eyebrow">Which home?</p>
	<div class="mt-4 grid gap-4 md:grid-cols-3" data-home-picker>
		{%- for p in properties %}
		<a href="?home={{ p.slug }}" data-home="{{ p.slug }}" class="group flex items-center gap-4 rounded-2xl bg-white p-3 ring-1 ring-ink-900/5 transition hover:ring-clay-500 data-[active=true]:ring-2 data-[active=true]:ring-clay-600">
			<img src="{{ p.cardImage.src }}" alt="" class="h-16 w-20 shrink-0 rounded-xl object-cover" eleventy:widths="240" sizes="80px">
			<span class="min-w-0">
				<span class="block truncate font-semibold text-ink-900">{{ p.name }}</span>
				<span class="block text-xs text-ink-500">{{ p.bedrooms }} bd · {{ p.bathrooms }} ba · sleeps {{ p.guests }} · {{ icon("star", "inline h-3 w-3 text-gold-500") }} {{ p.rating | rating }}</span>
			</span>
		</a>
		{%- endfor %}
	</div>
</section>

<section class="wrap pb-16">
	<div class="grid gap-10 lg:grid-cols-3">
		<div class="card overflow-hidden lg:col-span-2">
			<div class="border-b border-ink-900/5 px-6 py-5">
				<h2 class="text-xl font-semibold text-ink-900">Booking request form</h2>
				<p class="mt-1 text-sm text-ink-500">Prefer email? Write to <a href="mailto:{{ metadata.booking.email }}" class="font-medium text-clay-700 underline">{{ metadata.booking.email }}</a> with your dates and home.</p>
			</div>
			<iframe src="{{ metadata.booking.formUrl }}" title="Booking request form" width="100%" height="1827" class="block w-full bg-white" loading="lazy">Loading…</iframe>
		</div>
		<aside class="space-y-6">
			<div class="card p-6">
				<h2 class="text-lg font-semibold text-ink-900">Talk to a person</h2>
				<p class="mt-1 text-sm text-ink-500">{{ metadata.host.responseRate }} response rate, replies {{ metadata.host.responseTime }}.</p>
				<a href="mailto:{{ metadata.booking.email }}" class="mt-4 inline-flex items-center gap-2 text-sm font-medium text-ink-900 hover:text-clay-700">{{ icon("mail", "h-4 w-4 text-clay-600") }} {{ metadata.booking.email }}</a>
				<div class="mt-4 rounded-2xl bg-sand-100 p-3">
					<div class="overflow-x-auto">{% include "components/phone-svg.njk" %}</div>
					<p class="mt-1 text-xs text-ink-400">Our phone number, written by hand to keep the spam bots away.</p>
				</div>
			</div>
			<div class="card p-6">
				<h2 class="text-lg font-semibold text-ink-900">What's included in every quote</h2>
				<ul class="mt-3 space-y-2 text-sm text-ink-700">
					<li class="flex items-start gap-2">{{ icon("check", "mt-0.5 h-4 w-4 shrink-0 text-pool-600") }} Nightly rate, cleaning fee and Arizona lodging tax, itemized</li>
					<li class="flex items-start gap-2">{{ icon("check", "mt-0.5 h-4 w-4 shrink-0 text-pool-600") }} Any extras you ask for (pool heating, pets)</li>
					<li class="flex items-start gap-2">{{ icon("check", "mt-0.5 h-4 w-4 shrink-0 text-pool-600") }} Cancellation terms in writing</li>
					<li class="flex items-start gap-2">{{ icon("check", "mt-0.5 h-4 w-4 shrink-0 text-pool-600") }} Zero platform service fee</li>
				</ul>
				<a href="/agreement/" class="mt-4 inline-flex items-center gap-1 text-sm font-medium text-clay-700 hover:underline">Read the rental agreement {{ icon("arrow", "h-3.5 w-3.5") }}</a>
			</div>
			<div class="card p-6">
				<h2 class="text-lg font-semibold text-ink-900">Prefer Airbnb?</h2>
				<p class="mt-1 text-sm text-ink-500">Same homes, same hosts. You'll pay Airbnb's guest service fee on top.</p>
				<ul class="mt-3 space-y-2 text-sm">
					{%- for p in properties %}
					<li><a href="{{ p.airbnb }}" target="_blank" rel="noopener" class="inline-flex items-center gap-1 text-ink-700 hover:text-clay-700">{{ p.name }} {{ icon("external", "h-3.5 w-3.5") }}</a></li>
					{%- endfor %}
				</ul>
			</div>
		</aside>
	</div>
</section>

<script>
	(function () {
		var homes = [{% for p in properties %}{ name: {{ p.name | dump | safe }}, slug: "{{ p.slug }}" }{% if not loop.last %}, {% endif %}{% endfor %}];
		var names = homes.map(function (h) { return h.name; });
		var slugs = homes.map(function (h) { return h.slug; });
		var slug = new URLSearchParams(location.search).get("home");
		var i = slugs.indexOf(slug);
		if (i === -1) return;
		var box = document.getElementById("selected-home");
		box.querySelector("[data-selected-name]").textContent = names[i];
		box.classList.remove("hidden");
		box.classList.add("inline-flex");
		var card = document.querySelector('[data-home="' + slug + '"]');
		if (card) card.setAttribute("data-active", "true");
	})();
</script>
